   <property name="styleSheet">
    <string notr="true">QMenuBar {
    background-color: #212121;
    color: #ffffff;
    border-bottom: 2px solid #3d3d3d;
    padding: 2px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 4px 10px;
    margin: 2px;
}

QMenuBar::item:selected { 
    background-color: #3d3d3d;
    color: #ffffff;
    border-radius: 4px;
}
</string>
   </property>
