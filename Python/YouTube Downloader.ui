  <property name="styleSheet">
   <string notr="true">/* 1. Main background */
QMainWindow, QWidget#centralwidget, QFrame#frame {
    background-color: #0f0f0f;
}

/* 2. QFrames */
QFrame {
    background-color: #212121 !important;
    border: 1px solid #2f2f2f;
    border-radius: 12px;
}

/* 3. Text-labels, makes the text appear white and blocks Windows overrides */
QLabel {
    background-color: transparent !important;
    color: #ffffff !important; /* TVUNGET HVID: Stopper Windows i at gøre teksten usynlig eller lave lyse felter */
    font-family: &quot;Segoe UI&quot;, sans-serif;
}
QLabel#label, QLabel#label_2, QLabel#label_4{
    font-weight: bold;
    font-family: &quot;Segoe UI&quot;, sans-serif;
    color: #ffffff !important; /* SIKRER hvid tekst på dine tre info-labels i bunden */
}

/* 4. Textfields and Dropdowns */
QLineEdit, QComboBox {
    border: 1px solid #3d3d3d;
    border-radius: 8px;
    padding: 6px 12px;
    background-color: #121212 !important;
    color: #ffffff !important;
}

QLineEdit:focus, QComboBox:focus {
    border: 2px solid #ff0000;
    background-color: #0f0f0f !important;
}

QComboBox QAbstractItemView {
    background-color: #121212 !important;
    color: #ffffff !important;
    border: 1px solid #3d3d3d;
    selection-background-color: #ff0000;
    selection-color: #ffffff;
}

/* 5. Tjekbokse (Audio Only &amp; YouTube Auth) */
QCheckBox {
    background-color: transparent !important;
    color: #ffffff !important; /* TVUNGET HVID: Teksten ved tjekboksene forbliver altid læselig på mørk baggrund */
    font-family: &quot;Segoe UI&quot;, sans-serif;
    font-size: 13px;
    spacing: 6px;
}

/* 6. Faner i toppen (Single Video / Playlists) */
QTabBar::tab {
    background: transparent;
    color: #aaaaaa;
    padding: 8px 16px;
}
QTabBar::tab:selected {
    color: #ffffff;
    font-weight: bold;
}

/* 7. De røde YouTube-knapper */
QPushButton {
    background-color: #ff0000 !important;
    color: #ffffff !important;
    font-weight: bold;
    border: none;
    border-radius: 12px;
    padding: 10px 20px;
}
QPushButton:hover {
    background-color: #cc0000 !important;
}
QPushButton:pressed {
    background-color: #990000 !important;
}
</string>
  </property>
  <property name="tabShape">
   <enum>QTabWidget::TabShape::Rounded</enum>
  </property>
